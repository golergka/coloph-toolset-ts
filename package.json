{
  "name": "coloph-toolset-ts",
  "version": "0.1.0",
  "description": "Synchronous typed tools with explicit context and Zod contracts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/golergka/coloph-toolset-ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "test": "vitest run --coverage",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test && bun run build && node scripts/pack-smoke.mjs"
  },
  "dependencies": {
    "effect": "4.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "10.13.0",
    "typescript-eslint": "8.72.0",
    "prettier": "3.9.10",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@types/node": "24.10.1"
  }
}
